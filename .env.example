# Contraseña de aplicación de Google (requiere verificación en 2 pasos):
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Tope compartido de intentos simultáneos a AGY (entero positivo; default: 3).
# Se fija al primer uso del event loop; reiniciá el servidor para cambiarlo.
LINKEDOUT_AGY_MAX_CONCURRENTES=3

# Modo de prueba del mail: si tiene una dirección, TODO envío va a esa dirección (nunca al destinatario
# real) y el asunto lleva «[PRUEBA]». Vacía: los mails van a quien corresponde.
LINKEDOUT_MAIL_PRUEBA=
