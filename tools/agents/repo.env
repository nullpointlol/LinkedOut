# Configuración del workflow de agentes para LinkedOut (el resto del kit es idéntico en todos los repos).
REPO_NAME="LinkedOut"
# Ejecutor automático según cuota (plan del creador, 07/11/2026): AGY ↔ Codex.
EXECUTOR=agy
CODEX_REVIEW=diferida
AGY_QUOTA_WAIT=30
GATE_CMD="python -m pytest -q tests -p no:cacheprovider -n auto -m 'not aislado' && python -m pytest -q tests -p no:cacheprovider -m aislado"
GATE_GREP='^FAILED|^ERROR|Error|AssertionError|^E  '
GATE_RESTORE=""
GATE_FILE_CMD="python -m pytest -q -p no:cacheprovider {files}"
PROTECTED="tests/** conftest.py pytest.ini pyproject.toml setup.cfg"
BASE_BRANCH="main"
AUDIT_NOTE="portal de prueba en el puerto 1199 con LINKEDOUT_DATA_DIR (datos copiados) a 360, 375 y 1200 px; nunca el portal real (1111)"

# Otras formas de la suite completa que AGY no recibe (07/11/2026).
SUITE_CMDS="python -m pytest -q tests -p no:cacheprovider"
