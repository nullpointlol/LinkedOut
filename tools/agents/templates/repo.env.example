# Configuración del workflow de agentes para este repo. La leen todos los scripts de tools/agents/.
# Es lo único que cambia entre proyectos; el resto del kit es idéntico (~/.claude/agent-workflow).

REPO_NAME="__REPO__"
# Ejecutor por defecto de las misiones: agy (normal) o codex (por ejemplo, mientras AGY no tiene cuota).
# EXECUTOR=agy
# Rondas de corrección de Codex si la compuerta queda en rojo (no por integridad): por defecto 1; 0 = sin corrección.
# CODEX_EXEC_FIX_ROUNDS=1
# Modo de revisión de Codex: vacío (normal) o diferida (modo solo AGY: no llama a Codex en compuerta verde, registra en progreso.txt y métricas).
# CODEX_REVIEW=diferida
# Compuerta gratis: tests y QA. Corre con bash desde la raíz del worktree; 0 = verde.
GATE_CMD="__COMPLETAR__"
# Máximo por compuerta del kit (completa, rápida, base y holdout, incluido el QA que ejecuten); corta todo el árbol.
# El tiempo máximo efectivo es el menor entre GATE_TIMEOUT_MIN y 4 veces la última duración guardada sin corte (mínimo 300 s).
# Sin duración guardada se usa GATE_TIMEOUT_MIN; GATE_TIMEOUT_SEC, si está, manda sobre todo. El entorno manda sobre repo.env.
GATE_TIMEOUT_MIN=30
# Líneas de la salida de la compuerta que se le devuelven a AGY como fallos.
GATE_GREP='FAIL|FAILED|ERROR|Error|AssertionError'
# Rutas que se restauran después de la compuerta (por ejemplo, evidencias que regenera el QA).
GATE_RESTORE=""
# Archivos protegidos por el control de integridad (tests y configuración del runner), separados por espacios.
PROTECTED="tests/** test/** **/*.test.* **/*_test.* **/test_*.py conftest.py pytest.ini pyproject.toml setup.cfg package.json"
# 1 = comparar fallos con los números enmascarados (útil si el QA imprime medidas que varían). AGY recibe las líneas originales.
FAIL_NUM_MASK=0
# Regex (ERE) para partir líneas de fallo agregadas («N desbordes: a; b; c») en partes comparables; incluí el separador del prefijo
# para que no quede pegado al primer elemento. Ejemplo: '; |desbordes: '. Vacío = no partir.
FAIL_SPLIT=""
# Líneas que GATE_GREP atrapa pero son tests que pasan (por defecto: «✔ …» y «ok N»).
# GATE_IGNORE='^[[:space:]]*(✔|ok [0-9])' 
# QA del repo que Codex puede correr como ejecutor (misiones visuales o reintentos que fallaron por QA).
# QA_CMD=""
# Corre solo algunos archivos de test ({files} se reemplaza por la lista). Lo usa la compuerta incremental.
# Ejemplos: python -m pytest -q -p no:cacheprovider {files} · node --test {files}
GATE_FILE_CMD=""
# Regex (ERE) para identificar archivos de test que recibe GATE_FILE_CMD (compuerta rápida, tests de la misión,
# invariantes, repetición de inestables). Por defecto cubre test_x.py, x_test.py, x.test.mjs y tests/test_x.sh.
# TEST_FILE_REGEX='(^|/)(test_[^/]*\.[a-z]+|[^/]*_test\.[a-z]+|[^/]*\.test\.[a-z]+)$'
# Otras formas de la suite completa (una por línea) que AGY tampoco recibe en «Comandos permitidos»; GATE_CMD ya va.
# SUITE_CMDS=""
# Compuerta rápida en rondas intermedias (solo tests de la misión con GATE_FILE_CMD); 0 = siempre la completa.
FAST_GATE=1
# 1 = en misiones de tests, los tests de la misión corren con INVARIANT_CHECK=1 (solo invariantes) y tienen que pasar.
# Activalo solo si los tests del repo siguen la convención (cortan antes de las aserciones de defecto con esa variable).
INVARIANT_CHECK=0
# Respaldo de AGY SOLO ante saturación 503 (nunca por cuota). Por defecto: Opus 4.6 Thinking y después Sonnet 4.6.
# AGY_FALLBACK_MODELS="claude-opus-4-6-thinking claude-sonnet-4-6"
# Minutos a esperar si AGY sale con 3 (sin cuota) antes de reintentar la misma ronda (sin contarla como ronda). Vacío = no esperar.
# AGY_QUOTA_WAIT=30
# Horas máximas de espera por cuota de AGY desde la primera espera (por defecto 96 h). Al superarse, sale con 3.
# AGY_QUOTA_MAX_H=96
# Rama de integración (base de la revisión de la feature).
BASE_BRANCH="main"
# Tope de revisiones de feature por Codex antes de pasar a modo solo P1; por defecto 2.
# FEATURE_REVIEW_MAX=2
# Comandos literales que AGY puede correr (allowlist), separados por « · », si difieren de GATE_CMD.
# AGY_ALLOW=""
# Tests ocultos: por defecto usan GATE_CMD.
# HOLDOUT_CMD=""
# 1 = correr siempre la suite completa en el holdout, aunque el commit ya haya pasado la compuerta.
# HOLDOUT_FULL=0
# 0 = no revisar el plan con Codex antes de programar (casos-limite.md); por defecto 1.
# PLAN_REVIEW=1
# Auditoría visual de Claude (texto libre para el coordinador).
AUDIT_NOTE=""
# Variables extra que necesiten la compuerta o AGY:
# export PLAYWRIGHT_MODULE=...
